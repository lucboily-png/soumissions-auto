'use client'
import { useState } from 'react'

export default function GarageRecruitmentForm() {
  const [loading, setLoading] = useState(false)
  const [success, setSuccess] = useState(false)

  async function handleSubmit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault()
    setLoading(true)

    const form = e.currentTarget
    const formData = Object.fromEntries(new FormData(form))

    const res = await fetch('/api/recruit-garage', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData),
    })

    setLoading(false)
    if (res.ok) setSuccess(true)
  }

  if (success) {
    return (
      <div className="max-w-xl mx-auto bg-green-50 border border-green-200 rounded-xl p-6 text-center">
        <h3 className="text-xl font-semibold text-green-700 mb-2">
          Demande envoyée avec succès ✅
        </h3>
        <p className="text-green-700">
          Merci pour votre intérêt. Un membre de notre équipe vous contactera rapidement.
        </p>
      </div>
    )
  }

  return (
    <section className="bg-slate-50 py-12 px-4 rounded-2xl border border-slate-200">
      <div className="max-w-3xl mx-auto">
        {/* Intro */}
        <div className="mb-8 text-center">
          <h2 className="text-3xl font-bold text-slate-900 mb-3">
            Rejoignez le réseau Soumissions-Auto.ca
          </h2>
          <p className="text-slate-600 text-lg">
            Recevez des demandes de clients qualifiés dans votre région, sans frais fixes,
            sans engagement.
          </p>
        </div>

        {/* Formulaire */}
        <form onSubmit={handleSubmit} className="space-y-5">
          <div>
            <label className="block text-sm font-medium text-slate-700 mb-1">
              Nom du garage
            </label>
            <input
              name="garageName"
              required
              className="w-full rounded-lg border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-600"
              placeholder="Garage ABC"
            />
          </div>

          <div>
            <label className="block text-sm font-medium text-slate-700 mb-1">
              Votre nom
            </label>
            <input
              name="name"
              required
              className="w-full rounded-lg border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-600"
              placeholder="Jean Tremblay"
            />
          </div>

          <div>
            <label className="block text-sm font-medium text-slate-700 mb-1">
              Adresse courriel
            </label>
            <input
              name="email"
              type="email"
              required
              className="w-full rounded-lg border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-600"
              placeholder="contact@garageabc.ca"
            />
          </div>

          <div>
            <label className="block text-sm font-medium text-slate-700 mb-1">
              Téléphone
            </label>
            <input
              name="phone"
              className="w-full rounded-lg border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-600"
              placeholder="819-555-1234"
            />
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-1">
                Ville
              </label>
              <input
                name="city"
                className="w-full rounded-lg border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-600"
                placeholder="Sherbrooke"
              />
            </div>
			
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-1">
                Code postal
              </label>
              <input
                name="postalcode"
                className="w-full rounded-lg border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-600"
                placeholder="J1H 2A3"
              />
            </div>
          </div>

          <div>
            <label className="block text-sm font-medium text-slate-700 mb-1">
              Message (optionnel)
            </label>
            <textarea
              name="message"
              rows={4}
              className="w-full rounded-lg border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-600"
              placeholder="Parlez-nous brièvement de votre garage..."
            />
          </div>

          {/* CTA */}
          <div className="pt-4">
            <button
              disabled={loading}
              className="w-full rounded-xl bg-blue-600 py-4 text-white font-semibold text-lg hover:bg-blue-700 transition disabled:opacity-60"
            >
              {loading ? 'Envoi en cours…' : 'Envoyer'}
            </button>
          </div>
        </form>
      </div>
    </section>
  )
}
