'use client'

export default function TestStripe() {
  return (
    <button
      onClick={async () => {
        const res = await fetch('/api/stripe/checkout', {
          method: 'POST',
        })
        const data = await res.json()
        window.location.href = data.url
      }}
    >
      Tester Stripe
    </button>
  )
}
